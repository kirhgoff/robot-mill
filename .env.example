# ══════════════════════════════════════════════════════════════════════════════
# PROJECT-SPECIFIC — update these for each deployment
# ══════════════════════════════════════════════════════════════════════════════

# ── Required secrets ──────────────────────────────────────────────────────────
# Only the key matching PI_PROVIDER (below) is required; startup validation
# checks that one. Provide whichever provider(s) you intend to use:
#   PI_PROVIDER=anthropic  → ANTHROPIC_API_KEY
#   PI_PROVIDER=openrouter → OPENROUTER_API_KEY
#   PI_PROVIDER=openai     → OPENAI_API_KEY
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-proj-...
TELEGRAM_BOT_TOKEN=123456:ABC-...

# ── Per-key cost attribution (optional) ────────────────────────────────────────
# Give slices of work their own key so OpenRouter shows cost per slice. Any unset
# key falls back to the shared key above (leave blank to share for now).
#   OPENROUTER_API_KEY_BACKEND     — container workspace agents (this compose stack, incl. Telegram)
#   OPENROUTER_API_KEY_<PROJECT>   — host-runner agents for a repo (interactive /project + Linear
#                                    tickets), by uppercased repo name with non-alphanumerics as "_":
#                                    e.g. media-streaming -> OPENROUTER_API_KEY_MEDIA_STREAMING
#                                    (set these in host-runner.env)
#   OPENROUTER_API_KEY_SERVICE     — low-cost diagnostic/technical model (host-runner.env + health-monitor.env)
OPENROUTER_API_KEY_BACKEND=

# Your Telegram chat ID (get it from @userinfobot).
# Comma-separated for multiple users. Leave empty to allow all (dev only).
ALLOWED_CHAT_IDS=123456789

# GitHub HTTPS auth (alternative to SSH key in secrets/)
GITHUB_TOKEN=github_pat_...

# ══════════════════════════════════════════════════════════════════════════════
# DEFAULTS — these usually don't need changing
# ══════════════════════════════════════════════════════════════════════════════

# ── AI provider ───────────────────────────────────────────────────────────────
# PI_PROVIDER: anthropic | openrouter | openai
# For openrouter, PI_MODEL uses the "provider/id" slug form (e.g. openai/gpt-4o
# or anthropic/claude-opus-4.8). OpenRouter can serve OpenAI models too, so one
# OPENROUTER_API_KEY covers both Claude and GPT. For openai, PI_MODEL is a bare
# model id (e.g. PI_MODEL=gpt-6-luna).
PI_PROVIDER=openrouter
PI_MODEL=anthropic/claude-opus-4.8

# ── Git identity for commits made by the agent ────────────────────────────────
GIT_USER_EMAIL=kirill.lastovirya@gmail.com
GIT_USER_NAME=Kirill Lastovirya

# ── Backend configuration ─────────────────────────────────────────────────────
BACKEND_PORT=3100
# Homepage port — the console/Poop House is served here on the site root ("/").
# This takes over the address the media-streaming "portal" used to own.
HOMEPAGE_PORT=80
LOG_LEVEL=info

# linear-connector base URL the console and Telegram poll for tickets.
LINEAR_URL=http://host.docker.internal:3400

# Site-variation experiment (git worktrees + a dev server per variation). Off
# by default: the variation-manager code stays but is never constructed or
# routed unless this is "true".
VARIATIONS_ENABLED=false
